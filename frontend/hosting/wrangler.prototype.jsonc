// prototype.katta.cc as a Cloudflare Worker with static assets (no Worker script, so every request is free).
// Deployed by .github/workflows/prototype.yml on every push to the `prototype` branch:
//   npm run build:prototype:cloudflare && npx wrangler deploy --config hosting/wrangler.prototype.jsonc
// The custom domain is created by the deploy (routes below); katta.cc's DNS is already on Cloudflare.
{
  "name": "tech-katta-prototype",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "prototype.katta.cc", "custom_domain": true }],
  "assets": {
    "directory": "../dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
