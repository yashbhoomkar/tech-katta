{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/health.html"
    },
    {
      "source": "/health/",
      "destination": "/health.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
