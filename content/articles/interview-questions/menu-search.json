      "decisions": [
        {
          "id": "index-2",
          "q": "Searching \"paneer roll\" across lakhs of menus: how?",
          "options": [
            "SQL LIKE '%paneer%roll%' on the menu table",
            "An inverted index from each word to the dishes that have it",
            "A full scan of the city's menus held in the server's memory"
          ],
          "answer": 1,
          "why": "LIKE with a leading % can't use an index and reads every row; scanning memory gets slower with every menu. An inverted index goes straight from each word to its dishes and can rank them."
        },
        {
          "id": "fresh-2",
          "q": "A restaurant changes a price. How does search learn it?",
          "options": [
            "The whole index is rebuilt from scratch every night",
            "Search reads the main database on every query",
            "An event updates the index within seconds"
          ],
          "answer": 2,
          "why": "Events keep the index a few seconds behind the menu without making searches hit the main database; a nightly rebuild shows yesterday's prices all day."
        },
        {
          "id": "typos-2",
          "q": "\"panir\" should still find paneer. How?",
          "options": [
            "Fuzzy matching and synonyms when words are indexed and searched",
            "Store the common misspellings of every dish as extra dish names",
            "Ask \"did you mean paneer?\" and search again if they tap it"
          ],
          "answer": 0,
          "why": "Search engines compare words within an edit distance and map synonyms, so misspellings and local names match on the first try. Listing misspellings by hand never ends, and a second round-trip is slower."
        }
      ]
    },
