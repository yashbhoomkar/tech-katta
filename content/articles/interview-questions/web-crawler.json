        }
      ],
      "decisions": [
        {
          "id": "polite",
          "q": "How do you avoid overloading one website?",
          "options": [
            "Fetch as fast as possible",
            "Only crawl at night",
            "One line of links per site with a gap between fetches, and respect robots.txt"
          ],
          "answer": 2,
          "why": "A crawler that hammers a site gets blocked, and it is rude. Per-site lines with delays spread the load."
        },
        {
          "id": "seen",
          "q": "How do you avoid fetching the same page twice?",
          "options": [
            "Remember a fingerprint of every link seen (a Bloom filter or a set)",
            "Don't worry about it",
            "Crawl only home pages"
          ],
          "answer": 0,
          "why": "The web links to the same pages over and over; checking a compact set of seen links saves most of the work."
        },
        {
          "id": "io",
          "q": "Fetching is mostly waiting on the network. So each fetcher machine…",
          "options": [
            "Fetches one page at a time",
            "Keeps many connections open at once (asynchronous I/O)",
            "Runs inside the database"
          ],
          "answer": 1,
          "why": "While one page is on its way, hundreds of others can be too; one at a time leaves the machine idle."
        }
      ]
    },
