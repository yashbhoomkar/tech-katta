          ]
        },
        {
          "label": "Keep working when a machine or zone is down",
          "keys": [
            "down",
            "failure",
            "fails",
            "fault",
            "replica",
            "copies",
            "available",
            "survive",
            "zone"
          ]
        },
        {
          "label": "Grow by adding machines without moving most data",
          "keys": [
            "add machine",
            "adding machine",
            "add node",
            "adding node",
            "consistent hash",
            "scale out",
            "scale horizontally",
            "rebalanc",
