    "mutantsAllowedWhy": {
      "ttl:cache": "How long an item stays cached only changes how soon a change shows; no test asks for that.",
      "onezone:cache": "Six storage nodes can take every read for the 15 minutes the cache is gone: the replica only saves warming it up again."
    },
    "rubric": {
      "fr": [
        {
          "label": "get, put and delete by key",
          "keys": [
            "get(",
