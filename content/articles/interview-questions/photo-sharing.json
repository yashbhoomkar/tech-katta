      "decisions": [
        {
          "id": "upload-2",
          "q": "How does a phone upload a photo?",
          "options": [
            "Send the bytes to the API servers, which store them",
            "Get a signed link from the API, send bytes straight to storage",
            "Send the bytes to the API servers, which save them in the database"
          ],
          "answer": 1,
          "why": "Big uploads through app servers tie them up for seconds each, and image bytes in database rows make it huge and slow. A signed link lets object storage take the bytes while the API handles only the small details."
        },
        {
          "id": "sizes-2",
          "q": "Phones on slow networks need small images. When are smaller sizes made?",
          "options": [
            "Resized on every view, to the size the phone asks for",
            "On the phone, after it downloads the full photo",
            "A few sizes, once, in the background after upload"
          ],
          "answer": 2,
          "why": "Resizing once is cheap; resizing on every view repeats the work crores of times, and shrinking on the phone wastes its data on the full 3 MB first."
        },
        {
          "id": "serve-2",
          "q": "Who serves photos to viewers?",
          "options": [
            "A CDN in front of object storage",
            "The app servers, reading from object storage on each view",
            "Object storage directly, with a public link per photo"
          ],
          "answer": 0,
          "why": "Popular photos are viewed again and again from all over India; a CDN answers from servers near the viewer. Serving from app servers wastes them, and object storage alone is slower and costs more per view."
        }
      ]
    },
