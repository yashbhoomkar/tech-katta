      "decisions": [
        {
          "id": "exact-2",
          "q": "Advertisers pay per click. A counting server crashes halfway. What keeps the counts right?",
          "options": [
            "Clicks stay in a replayable log, and are counted once each by click id",
            "Each counter writes its running totals to the database every second",
            "The app resends every click until a counter confirms it has been counted"
          ],
          "answer": 0,
          "why": "Replaying the log recovers what the crashed counter hadn't saved, and counting by click id makes the replay safe. Saving totals every second still loses up to a second and double-counts after a restart; blind resends count twice."
        },
        {
          "id": "buckets-2",
          "q": "Reports by minute, hour and day: how?",
          "options": [
            "Recount the raw clicks for the asked range whenever a report is opened",
            "Count clicks into per-minute buckets; add buckets up for longer ranges",
            "Keep one running total per ad per day, updated on every click"
          ],
          "answer": 1,
          "why": "Small buckets are cheap to update and any range is a sum of a few of them. Recounting raw clicks gets slower every day, and daily totals can't show the last hour."
        },
        {
          "id": "fraud-2",
          "q": "Bots click ads too. What do you do?",
          "options": [
            "Count everything now and refund advertisers who complain later",
            "Block any device that clicks more than once a day on any ad",
            "Mark suspicious clicks (too fast, no view) and leave them out"
          ],
          "answer": 2,
          "why": "Advertisers should only pay for real clicks. Marking suspicious ones before billing keeps the bill honest; refunds on complaint are unfair to quiet advertisers, and a blunt daily block throws away real repeat customers."
        }
      ]
    },
