      "est": [
        {
          "id": "reads",
          "label": "Home-screen loads a second at peak",
          "unit": "/s",
          "answer": 6000,
          "tol": 3,
          "how": "2 crore people × 5 loads ÷ 86,400 ≈ 1,200 a second; dinner packs it ~5×"
        },
        {
          "id": "writes",
          "label": "Status changes a second",
          "unit": "/s",
          "answer": 35,
          "tol": 3,
          "how": "3 lakh restaurants × 10 changes a day ÷ 86,400"
        },
        {
          "id": "data",
          "label": "Size of all restaurant data",
          "unit": "MB",
          "answer": 300,
          "tol": 3,
          "how": "3 lakh × ~1 KB: small enough for every server to keep a copy"
        }
      ],
      "api": [
        {
          "label": "Restaurants near a location",
          "method": "GET",
          "path": "^/(api/)?(v\\d+/)?restaurants"
        },
        {
          "label": "A restaurant changes its status",
          "method": "PUT|PATCH|POST",
          "path": "^/(api/)?(v\\d+/)?restaurants/[^/]+/status"
        }
      ],
      "decisions": [
        {
          "id": "near-2",
          "q": "How do you find restaurants within 5 km quickly?",
          "options": [
            "Work out the distance to every restaurant on each request",
            "Index them by map cell; look in the user's cell and its neighbours",
            "Filter by the user's city, then sort that whole city by its distance"
          ],
          "answer": 1,
          "why": "Cells turn \"near this point\" into a few index lookups. Measuring the distance to every restaurant, or to every one in a big city, on every request does not scale at thousands a second."
        },
        {
          "id": "status-2",
          "q": "Open-now and busy status change all evening. Where does that live?",
          "options": [
            "Inside the geo index, which is rebuilt from scratch every few minutes",
            "In the app, which asks each restaurant for its status",
            "Kept apart, updated as it changes, applied after the lookup"
          ],
          "answer": 2,
          "why": "Locations rarely change but status changes often. Keeping status apart means the geo index stays stable and status is always current; rebuilding the index for every status change is wasteful."
        },
        {
          "id": "cache-2",
          "q": "Many people in the same area ask the same thing. What helps most?",
          "options": [
            "Cache results per map cell for a minute or two",
            "A larger database instance with more memory",
            "Cache each user's own results for an hour"
          ],
          "answer": 0,
          "why": "Everyone in one cell gets the same list, so a short cache per cell answers most home screens. A per-user cache rarely hits and goes stale as kitchens close."
        }
      ]
    },
    "hints": [
      {
        "step": "requirements",
        "x": "What does the home screen show, and what can a restaurant change about itself during dinner?"
      },
      {
        "step": "estimates",
        "x": "Work out the size of all restaurant data. If it is a few hundred MB, where can it live?"
      },
      {
        "step": "api",
        "x": "One read with a location, sort, filters and a cursor; one write for a restaurant's status."
      },
      {
        "step": "design",
        "x": "Reads outnumber writes about 200 to 1, and the data is tiny. Answer reads from memory, not the database."
      },
      {
        "step": "design",
        "x": "Put a cache in front of the database, but keep answers only briefly (or clear them when a restaurant changes): a closed restaurant must vanish within a minute."
      },
      {
        "step": "design",
        "x": "When the match ends, traffic jumps 2.5× in a minute. Have the servers for it before 8 pm: autoscaling needs 4 minutes."
      },
      {
        "step": "design",
        "x": "Two server groups and a Multi-AZ database keep the home screen up when something dies."
      }
    ]
  }
