        "id": "nearby",
        "name": "Open restaurants near me",
        "kind": "read",
        "share": 0.995,
        "sample": true,
        "request": {
          "method": "GET",
          "path": "/v1/restaurants?lat=19.0765&lng=72.878&open=true"
