        "bytesOut": 3000,
        "keys": {
          "entity": "restaurants",
          "skew": "zipf",
          "active": 300000
        },
        "steps": [
          {
            "id": "s1",
            "op": "query",
            "entity": "restaurants",
            "where": {
              "open": true
            },
            "near": {
              "field": "location",
              "at": [
                19.0765,
                72.878
              ],
              "km": 5
            },
            "limit": 10,
            "fields": [
              "restaurant_id",
              "name",
              "rating"
            ],
            "matches": 400
          }
        ],
        "respond": {
          "status": 200,
          "body": {
            "restaurants": "$s1"
          }
        },
        "slo": {
          "availability": 99.9,
          "p99Ms": 200
        },
        "consistency": {
          "maxStalenessSec": 60
        }
      },
      {
        "id": "status",
        "name": "A restaurant opens",
        "kind": "write",
        "share": 0.005,
        "request": {
