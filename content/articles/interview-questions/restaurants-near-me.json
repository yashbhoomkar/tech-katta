      "fr": [
        {
          "label": "List restaurants near my location that deliver to me",
          "keys": [
            "near",
            "nearby",
            "location",
            "deliver",
            "within",
            "radius",
            "distance"
          ]
        },
        {
          "label": "Only restaurants open right now",
          "keys": [
            "open now",
            "open right now",
            "currently open",
            "only open",
            "closed",
            "open restaurants"
          ]
        },
        {
          "label": "Sort and filter (distance, rating, veg)",
          "keys": [
            "sort",
            "filter",
            "rating",
            "veg",
            "cuisine"
          ]
        },
        {
          "label": "Page through results",
          "keys": [
