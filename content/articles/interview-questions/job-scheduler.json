      "decisions": [
        {
          "id": "due",
          "q": "How do you find the jobs due now?",
          "options": [
            "Scan every job every second",
            "Keep jobs indexed by due time and read the next few",
            "One timer thread per job"
          ],
          "answer": 1,
          "why": "An index by due time makes \"what's next\" a short read however many jobs there are."
        },
        {
          "id": "lease",
          "q": "A worker dies halfway through a job. What happens?",
          "options": [
            "Workers claim jobs with a lease; if a job isn't finished in time, another worker takes it",
            "The job is lost",
            "Every job always runs on two workers"
          ],
          "answer": 0,
          "why": "A lease means a crashed worker's job comes back by itself, without running every job twice."
        },
        {
          "id": "idem",
          "q": "For retries to be safe, a job should be…",
          "options": [
            "Fast",
            "Short",
            "Idempotent: running it twice has the same effect as once"
          ],
          "answer": 2,
          "why": "With leases and retries, a job can run more than once; making it idempotent makes that harmless."
        }
      ]
    },
