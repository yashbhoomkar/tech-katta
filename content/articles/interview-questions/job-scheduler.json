      {
        "step": "design",
        "x": "Due jobs go into a Queue; workers claim them with a lease and run them. The queue absorbs the 8 pm wall."
      },
      {
        "step": "design",
        "x": "Workers sized for a steady rate drain the burst within minutes; nothing is dropped."
      },
      {
        "step": "design",
        "x": "Two groups of schedulers and workers, Multi-AZ database: an accepted job always runs."
      }
