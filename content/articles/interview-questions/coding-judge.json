          "path": "^/(api/)?(v\\d+/)?submissions/?$"
        },
        {
          "label": "Get a submission's verdict",
          "method": "GET",
          "path": "^/(api/)?(v\\d+/)?submissions/[^/]+"
        },
        {
          "label": "Leaderboard",
          "method": "GET",
          "path": "^/(api/)?(v\\d+/)?leaderboard"
        }
      ],
      "decisions": [
        {
          "id": "where-2",
          "q": "Where does a submission's code run?",
          "options": [
            "On the API servers, in a separate process per submission",
            "In sandboxed runners limited in CPU, memory, time and network",
            "In the candidate's browser, with only the verdict sent back"
          ],
          "answer": 1,
          "why": "The code could be anything: an endless loop, a fork bomb, a network attack. It must run sealed off and limited, away from everything else. A process on the API servers can still harm them, and anything run in the browser can be faked."
        },
        {
          "id": "rush-2",
          "q": "In the last minutes, thousands submit at once. Then?",
          "options": [
            "Start a runner for each submission the moment it arrives",
            "Turn away new submissions until the runners catch up",
            "Queue them; runners take them at their own pace meanwhile"
          ],
          "answer": 2,
          "why": "Runners have a fixed capacity; the queue turns a spike into a short wait instead of crashed runners. Starting one per submission overloads the machines, and refusing submissions in the final minutes is unfair."
        },
        {
          "id": "hidden-2",
          "q": "Where are the hidden test cases kept?",
          "options": [
            "Only on the runners' side, never sent anywhere else",
            "In the browser, encrypted, and checked there",
            "In the problem statement, shown as worked examples"
          ],
          "answer": 0,
          "why": "Anything sent to the browser can be read, encrypted or not, so hidden tests stay with the runners and only the verdict goes back."
        }
      ]
    },
    "hints": [
      {
        "step": "requirements",
        "x": "The code is written by strangers. Besides verdicts and a leaderboard, what must the judge never let it do?"
      },
      {
        "step": "estimates",
        "x": "Average rate is easy; the last 15 minutes are the problem. How many cores does the rush need if each submission takes 2 seconds of CPU?"
      },
      {
        "step": "api",
        "x": "POST a submission returns 202 (\"accepted for judging\") with an id; the client then asks for the verdict."
      },
      {
        "step": "design",
        "x": "Judging is slow work nobody needs inside the request. Put a Queue between the API servers and the judge workers."
      },
      {
        "step": "design",
        "x": "Size workers for a steady rate, not the rush; the queue holds the rush and the workers catch up within minutes."
      },
      {
        "step": "design",
        "x": "API servers in three zones, sandboxed judges in two, a Multi-AZ database: no lost submissions."
      }
    ]
