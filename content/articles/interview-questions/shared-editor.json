      "ops": {
        "rows": 100000000000,
        "rowBytes": 200,
        "growthPerDay": 1000000000,
        "fields": {
          "doc_id": "string",
          "version": "int",
          "op": "json",
          "author_id": "string",
          "at": "time"
        },
