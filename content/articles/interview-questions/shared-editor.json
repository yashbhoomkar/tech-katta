        {
          "id": "edits",
          "label": "Edit batches a second at peak",
          "unit": "/s",
          "answer": 40000,
          "tol": 3,
          "how": "40,000 editors × 1 batch a second"
        },
        {
          "id": "servers",
          "label": "Document servers",
          "unit": "servers",
          "answer": 10,
          "tol": 3,
          "how": "20,000 open documents ÷ 2,000 each"
        },
        {
          "id": "log",
          "label": "Log written per peak hour",
          "unit": "GB",
          "answer": 15,
          "tol": 3,
          "how": "40,000 × 100 bytes × 3,600 s"
        }
      ],
      "api": [
        {
          "label": "Open a document (snapshot + sequence)",
          "method": "GET",
          "path": "^/(api/)?(v\\d+/)?(docs|documents)/[^/]+"
        },
        {
          "label": "Send an edit",
          "method": "POST|PATCH",
          "path": "^/(api/)?(v\\d+/)?(docs|documents)/[^/]+/(edits|ops|operations)"
        }
      ],
      "decisions": [
        {
          "id": "merge-2",
          "q": "Two people type in the same paragraph at once. What happens?",
          "options": [
            "The paragraph is locked for whoever started typing first",
            "OT or CRDTs merge both edits the same way on every copy",
            "Each save replaces the paragraph; the last save wins"
          ],
          "answer": 1,
          "why": "Locks get in the way of writing together, and \"last save wins\" loses work. Operational transforms or CRDTs make every copy end up the same with both edits kept."
        },
        {
          "id": "store-2",
          "q": "How is a document stored?",
          "options": [
            "The whole document saved again after every change made",
            "The document saved only when someone presses Save",
            "Every edit added to a log, with a snapshot now and then"
          ],
          "answer": 2,
          "why": "Small edits are cheap to add and keep history; snapshots mean nobody replays a year of edits to open the document. Saving the whole document per keystroke is heavy, and waiting for Save loses unsaved work."
        },
        {
          "id": "live-2",
          "q": "How do other people's cursors and edits appear?",
          "options": [
            "Pushed over open connections to everyone in the document",
            "Each app asks the server for any new changes every 10 seconds",
            "Each app asks for changes whenever its user types"
          ],
          "answer": 0,
          "why": "Writing together only feels live if edits arrive within a fraction of a second, even while you aren't typing. Polling is either slow or wasteful."
        }
      ]
    },
    "hints": [
      {
        "step": "requirements",
        "x": "Three properties fight each other: instant typing, no lost edits, identical results. Name all three."
      },
      {
        "step": "estimates",
        "x": "Editors × batches a second gives edits a second; open documents ÷ documents per server gives servers."
      },
      {
        "step": "api",
        "x": "Open a document (snapshot and its sequence number), send edits based on the sequence you saw, receive others' edits with theirs."
      },
      {
        "step": "design",
        "x": "Each document's edits get one order in a log: an event stream partitioned by document keeps them in order, lets a stream processor save them, and feeds the gateways that send them to the others."
      },
      {
        "step": "design",
        "x": "40,000 edits a second is a lot of writes: split them over several databases by document, each edit keyed by document and version."
      },
      {
        "step": "design",
        "x": "Edit servers and gateways in three zones; a stream and a multi-zone store keep an acknowledged edit safe."
      }
    ]
  }
