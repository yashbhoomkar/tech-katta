      "decisions": [
        {
          "id": "segments",
          "q": "Why cut videos into short segments (HLS or DASH)?",
          "options": [
            "Players switch quality between segments as the network changes, and CDNs cache each segment",
            "They take less disk space",
            "Uploads are faster"
          ],
          "answer": 0,
          "why": "Short segments let the player pick the next one at a quality that fits the connection right now, and each one is a small file a CDN can cache."
        },
        {
          "id": "transcode",
          "q": "When are the different qualities made?",
          "options": [
            "Once after upload, by transcoders taking work from a queue",
            "On the fly for every viewer",
            "Never: send the original file"
          ],
          "answer": 0,
          "why": "Transcoding is slow and heavy. Doing it once per video, in the background, means every viewer gets ready-made files."
        },
        {
          "id": "resume",
          "q": "A phone loses its network halfway through uploading a 2 GB video. Then?",
          "options": [
            "Start again from zero",
            "The upload resumes from the last chunk it sent",
            "Fail the upload"
          ],
          "answer": 1,
          "why": "Resumable uploads in chunks mean a dropped connection costs one chunk, not the whole file."
        }
      ]
    },
    "hints": [
      {
        "step": "requirements",
        "x": "Uploading, processing, watching. Which one sets the bandwidth bill?"
      },
      {
        "step": "estimates",
        "x": "Views × minutes × bitrate gives terabytes a day. Divide by seconds for Gbps."
      },
      {
        "step": "api",
        "x": "Create a video and get signed URLs for each part; mark it uploaded; players fetch a playlist and then segments."
      },
      {
        "step": "design",
        "x": "Segments never change once encoded. A CDN answers 98% of playback; your servers see 2%."
      },
      {
        "step": "design",
        "x": "A viral video quadruples traffic, but with the CDN in front your servers barely notice."
      },
      {
        "step": "design",
        "x": "Behind the CDN: two server groups, a cache for video details, a Multi-AZ database."
      }
    ],
