      "decisions": [
        {
          "id": "rank-2",
          "q": "The top 100, and my rank among 50 lakh players, in under 100 ms. How?",
          "options": [
            "ORDER BY score in the database for each request",
            "A sorted set in memory, ordered by score",
            "A ranking recomputed every minute by a batch job"
          ],
          "answer": 1,
          "why": "Sorting 50 lakh rows per request is far too slow, and a ranking from a minute ago misses the question that just closed. A sorted set keeps the order as scores change and answers any rank quickly."
        },
        {
          "id": "burst-2",
          "q": "A question closes and 30 lakh right answers score at once. Then?",
          "options": [
            "Each answer request updates the sorted set before it returns",
            "Turn away answers that arrive after the first few seconds",
            "Queue the answers; workers add the points at a steady pace"
          ],
          "answer": 2,
          "why": "The queue absorbs the burst; ranks are a few seconds behind for a moment, and nothing falls over. Updating inside every request makes the burst hit the sorted sets all at once; dropping late answers is unfair."
        },
        {
          "id": "restart-2",
          "q": "The in-memory store restarts. What about the rankings?",
          "options": [
            "Rebuilt from the scores kept in the database",
            "Rebuilt from the players' phones, which keep their own score",
            "Started again from zero for the rest of the match"
          ],
          "answer": 0,
          "why": "Memory is fast but not the record. The database keeps every score, so the sorted set can be rebuilt; phones can be tampered with, and starting from zero is unfair to everyone."
        }
      ]
