# Every setting the API reads, with its default. Copy to .env for local runs (never commit .env).
# On the VPS these are written by .github/workflows/deploy-backend.yml (systemd drop-in + /etc/tech-katta/api.env);
# on any other host, set them in its dashboard. HOSTING.md says which ones matter when moving.

# --- Where it listens ---------------------------------------------------------------------------------
# 127.0.0.1 behind Nginx on the VPS; 0.0.0.0 on platforms that route to the app themselves (containers, PaaS).
HOST=127.0.0.1
# 5000 on the VPS; most platforms set PORT themselves.
PORT=5000

# --- Who may call it ----------------------------------------------------------------------------------
# The site's address: the only origin allowed to send cookies and changes.
FRONTEND_ORIGIN=https://tech.katta.cc
# The owner's analytics page, allowed to read /v1/admin/*.
ANALYTICS_ORIGIN=https://analytics.katta.cc
# Request headers that carry the visitor's address for rate limits, first one set wins.
# The default fits Nginx + Cloudflare on the VPS. Behind Cloudflare alone, use cf-connecting-ip; behind another
# proxy, the single-address header it sets and a visitor can't (never X-Forwarded-For, which a visitor can extend).
CLIENT_IP_HEADERS=x-real-ip,cf-connecting-ip

# --- Content ------------------------------------------------------------------------------------------
# Folder of site content. Defaults to the repository's content/ folder; the VPS serves dated releases
# from /var/lib/tech-katta/content/current. A content change on other hosts is simply a new deploy.
# CONTENT_DIR=

# --- Judging submissions ------------------------------------------------------------------------------
# Designs judged at once on worker threads (1-8). Default: one fewer than the CPUs, at most 2. Use 1 on one shared CPU.
# JUDGE_WORKERS=

# --- Sign-in and accounts (all three required; sign-in stays off without them) ------------------------
GOOGLE_CLIENT_ID=
# Secret: the MongoDB Atlas connection string for the API's database user.
MONGODB_URI=
# Secret: at least 32 random characters.
SESSION_SECRET=
# Database for accounts (default techkatta_app).
# ACCOUNTS_DB=techkatta_app
# Extra admin accounts for /v1/admin/*, comma separated (optional).
# ADMIN_EMAILS=
# 0 only for local http testing; cookies are Secure everywhere else.
# COOKIE_SECURE=1
# Tests only: a stand-in for Google's key endpoint.
# GOOGLE_JWKS_URL=
