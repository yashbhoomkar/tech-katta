# Node.js port inside the process/container.
# Docker Compose pins the container port to 5000; use PORT when running Node directly.
PORT=5000

# Docker Compose host-side port published on 127.0.0.1 only.
# This is not the Node.js PORT setting.
BACKEND_PORT=5002

# Exact browser origin allowed to call the API.
FRONTEND_ORIGIN=https://tech.katta.cc

# Optional. Leave empty to use local fallback content when MongoDB is unavailable.
# Never commit a real credential-bearing URI.
MONGODB_URI=

# MongoDB database name.
MONGODB_DB=techkatta
